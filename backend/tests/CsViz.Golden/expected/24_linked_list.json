  "source": "using System;\n\nclass Program\n{\n    static void Main()\n    {\n        Node head = new Node(1);\n        head.Next = new Node(2);\n        head.Next.Next = new Node(3);\n        int sum = 0;\n        Node cur = head;\n        while (cur != null)\n        {\n            sum \u002B= cur.Value;\n            Console.WriteLine(cur.Value);\n            cur = cur.Next;\n        }\n        Console.WriteLine(sum);\n        Console.WriteLine(head.Next.Next.Next == null);\n    }\n}\n\nclass Node\n{\n    public int Value;\n    public Node Next;\n    public Node(int v) { Value = v; }\n}\n",
